{
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Obtiene el clima actual para una ubicación.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "Ciudad o país del que se desea saber el clima"
            },
            "date": {
              "type": "string",
              "description": "YYYY-MM-DD"
            }
          },
          "required": ["location", "date"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "create_reminder",
        "description": "Crea un reminder en el calendario interno y agenda recordatorio por WhatsApp.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Fecha y hora del reminder. Acepta 'YYYY-MM-DD HH:MM', 'YYYY-MM-DDTHH:MM[:SS]' o solo 'HH:MM' (se interpreta como hoy)."
            },
            "title": {
              "type": "string",
              "description": "Título descriptivo del reminder"
            },
            "wa_msg_id": {
              "type": "string",
              "description": "ID del mensaje de WhatsApp asociado (opcional)."
            }
          },
          "required": ["date", "title"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "lookup_customer",
        "description": "Busca la información del cliente por su ID.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "customer_id": {
              "type": "integer",
              "description": "ID del cliente"
            }
          },
          "required": ["customer_id"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "create_grocery_list",
        "description": "Convierte la petición del usuario en una lista de productos para ir al supermercado.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "description": "Listado limpio de productos en singular, sin comentarios adicionales.",
              "items": { "type": "string" }
            }
          },
          "required": ["items"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "notify_creators",
        "description": "Se llama cuando el usuario quiere que el bot avise a sus creadores o desarrolladores.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "user_message": {
              "type": "string",
              "description": "Mensaje original del usuario."
            },
            "sender_name": {
              "type": "string",
              "description": "Nombre del usuario que envía el reporte."
            }
          },
          "required": ["user_message", "sender_name"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "check_availability",
        "description": "Devuelve los bloques libres en Google Calendar para la fecha indicada.",
        "parameters": {
          "type": "object",
          "properties": {
            "date":        { "type": "string",  "description": "YYYY-MM-DD" },
            "start_time":  { "type": "string",  "description": "HH:MM (opcional)" },
            "end_time":    { "type": "string",  "description": "HH:MM (opcional)" }
          },
          "required": ["date"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "schedule_meeting",
        "description": "Crea un evento en Google Calendar y notifica a Lucas.",
        "parameters": {
          "type": "object",
          "properties": {
            "date":             { "type": "string",  "description": "YYYY-MM-DD HH:MM" },
            "title":            { "type": "string",  "description": "Título de la reunión" },
            "duration_minutes": { "type": "integer", "description": "Duración (min)", "default": 60 }
          },
          "required": ["date", "title"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "create_habit",
        "description": "Crea un nuevo hábito.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Nombre corto del hábito (ej. “Tomar agua”)."
            },
            "recordatorio_horas": {
              "type": "integer",
              "description": "Hora preferida para consultarle si cumplió (0-23)."
            }
          },
          "required": ["name", "recordatorio_horas"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "delete_habit",
        "description": "Desactiva o elimina un hábito existente.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "description": "Nombre exacto del hábito a eliminar." }
          },
          "required": ["name"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "list_habits",
        "description": "Devuelve el listado de hábitos (activos/inactivos) del usuario.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "reactivate_habit",
        "description": "Reactiva un hábito previamente desactivado.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "description": "Nombre exacto del hábito." }
          },
          "required": ["name"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "enviar_mensaje",
        "description": "Envía (o programa) un mensaje de WhatsApp a un tercero.",
        "parameters": {
          "type": "object",
          "properties": {
            "telefono":   { "type": "string", "description": "Número con código de país, formato +598..." },
            "mensaje":    { "type": "string", "description": "Texto a enviar" },
            "fecha_hora": { "type": "string", "description": "ISO-8601 en America/Montevideo; si se omite/es null, se envía ahora." }
          },
          "required": ["telefono", "mensaje"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "summarize_pdf",
        "description": "Descarga y resume un documento PDF en texto conciso.",
        "strict": true,
        "parameters": {
          "type": "object",
          "properties": {
            "pdf_url": {
              "type": "string",
              "description": "URL donde se puede descargar el PDF."
            }
          },
          "required": ["pdf_url"],
          "additionalProperties": false
        }
      }
    }
  ]
}

